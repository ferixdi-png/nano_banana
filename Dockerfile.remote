FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium xvfb x11vnc fluxbox nginx apache2-utils novnc websockify \
    ca-certificates fonts-liberation fonts-noto-color-emoji \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcups2 \
    libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
    libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 \
    libxfixes3 libxkbcommon0 libxrandr2 xdg-utils \
    && pip install --no-cache-dir playwright \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY remote_browser.py /app/remote_browser.py
COPY nginx.remote.conf /etc/nginx/conf.d/default.conf
COPY remote-entrypoint.sh /app/remote-entrypoint.sh
RUN chmod +x /app/remote-entrypoint.sh && rm -f /etc/nginx/sites-enabled/default
EXPOSE 10000
CMD ["/app/remote-entrypoint.sh"]
